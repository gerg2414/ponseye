# Railway Bitquery recorder only. Never expose these in the dashboard.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
BITQUERY_CLIENT_ID=
BITQUERY_CLIENT_SECRET=
BITQUERY_MIGRATION_TEST_ENABLED=false

# Optional recorder settings
PORT=3001
LOG_LEVEL=info

# How far back the initial seed reaches on startup. The backfill pages through
# this whole window once, then the forward cursor takes over.
BITQUERY_BACKFILL_HOURS=48
# How long a token keeps receiving live price and trade-flow updates after it
# migrates. Older rows stay in the table as historical record.
BITQUERY_TRACKING_WINDOW_HOURS=48

# Stake per paper trade. Stored on each position as it opens, so changing this
# affects new trades only and never restates one already taken.
POSITION_SIZE_USD=50

BITQUERY_MIGRATION_POLL_MS=15000
BITQUERY_METRICS_POLL_MS=5000

# Vercel dashboard server only. Do not prefix the service key with NEXT_PUBLIC.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
