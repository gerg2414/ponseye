# Railway GMGN recorder only. Never expose these in the dashboard.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GMGN_API_KEY=
BITQUERY_CLIENT_ID=
BITQUERY_CLIENT_SECRET=
BITQUERY_MIGRATION_TEST_ENABLED=false

# Optional recorder settings
PORT=3001
LOG_LEVEL=info
GMGN_DISCOVERY_INTERVAL_MS=5000
GMGN_KLINE_INTERVAL_MS=10000
BITQUERY_MIGRATION_POLL_MS=15000
BITQUERY_METRICS_POLL_MS=10000

# Vercel dashboard server only. Do not prefix the service key with NEXT_PUBLIC.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
