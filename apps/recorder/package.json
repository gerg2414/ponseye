{
  "name": "@ponseye/recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backfill:migration-prices": "tsx --env-file=../../.env src/backfill-migration-prices.ts",
    "snapshots": "tsx --env-file=../../.env src/build-snapshots.ts",
    "curve": "tsx --env-file=../../.env src/build-curve-stats.ts",
    "snapshots:refresh": "tsx --env-file=../../.env src/refresh-snapshots.ts",
    "holders": "tsx --env-file=../../.env src/build-holders.ts",
    "backtest": "tsx --env-file=../../.env src/run-backtest.ts",
    "compare": "tsx --env-file=../../.env src/compare-strategies.ts",
    "seed:positions": "tsx --env-file=../../.env src/seed-positions.ts",
    "control": "tsx --env-file=../../.env src/control-test.ts",
    "timing": "tsx --env-file=../../.env src/entry-timing-test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
